[Unit]
Description=H028 isolated Qwen Ada 200K owner and resource guard
After=docker.service local-ai-fan-boost.service
Requires=docker.service local-ai-fan-boost.service
RequiresMountsFor=/data /data/models-large
[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /data/services/qwen-ada200k-h028-20260929/source/ada_supervisor.py
Restart=no
TimeoutStopSec=50
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
