# PROPOSAL ONLY. No installation/enablement in H013-FAN-SOURCE.
[Unit]
Description=Allowlisted NVML integrated-fan thermal boost
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
User=root
Group=root
UMask=0077
StateDirectory=local-ai-fan-boost
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/lib/local-ai-fan-boost/fan_boost.py run
# systemd runs this after failure/watchdog/clean stop; it NEVER restores default.
ExecStopPost=/usr/bin/python3 /usr/local/lib/local-ai-fan-boost/fan_boost.py failsafe
WatchdogSec=20
TimeoutStopSec=10
KillMode=control-group
SendSIGKILL=yes
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# PrivateDevices MUST NOT be enabled: the reviewed NVIDIA device access is needed.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
