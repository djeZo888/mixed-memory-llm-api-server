[Unit]
Description=H019 single short text and full17 native qualification
RequiresMountsFor=/data /data/models-large

[Service]
Type=simple
User=root
UMask=0077
Restart=no
ExecStart=/usr/bin/python3 -I -B /data/build/H019-20260928/worker1-short/short.py run
ExecStopPost=/usr/bin/python3 -I -B /data/build/H019-20260928/worker1-short/short.py settle
RuntimeMaxSec=15min
TimeoutStopSec=65
KillMode=control-group
StandardOutput=journal
StandardError=journal
