{
  "schema_version": 1,
  "id": "qwen38-27b-256k",
  "model": "qwen38-27b-fp8",
  "runtime": "sglang-qwen38-0.5.19",
  "purpose": "Bounded source-only native 256k Qwen3.8 FP8 variant; activation requires reviewed L1 integration and independent actual-image/live gates",
  "container_name": "llmctl-qwen38-27b-256k",
  "endpoint": {
    "host": "127.0.0.1",
    "port": 30004,
    "api_prefix": "/v1",
    "served_model": "qwen3.8-27b"
  },
  "container_port": 30004,
  "container_host": "0.0.0.0",
  "auth": {
    "key_file": {
      "role": "data",
      "suffix": "services/secrets/llm-api-key"
    },
    "container_key_file": "/run/secrets/llm-api-key",
    "mode": "0600"
  },
  "paths": {
    "model": {
      "role": "models",
      "suffix": "qwen38-27b-fp8"
    },
    "cache": {
      "role": "models",
      "suffix": "runtime-cache/sglang-qwen38-0.5.19"
    },
    "logs": {
      "role": "data",
      "suffix": "logs/llmctl/qwen38-27b-256k"
    },
    "service": {
      "role": "data",
      "suffix": "services/llm-manager/qwen38-27b-256k"
    }
  },
  "mounts": [
    {
      "source": {
        "role": "models",
        "suffix": "qwen38-27b-fp8"
      },
      "target": "/models",
      "read_only": true,
      "required_role": "models"
    },
    {
      "source": {
        "role": "models",
        "suffix": "runtime-cache/sglang-qwen38-0.5.19"
      },
      "target": "/cache",
      "read_only": false,
      "required_role": "models"
    },
    {
      "source": {
        "role": "data",
        "suffix": "logs/llmctl/qwen38-27b-256k"
      },
      "target": "/logs",
      "read_only": false,
      "required_role": "data"
    },
    {
      "source": {
        "role": "data",
        "suffix": "services/llm-manager/qwen38-27b-256k"
      },
      "target": "/service",
      "read_only": false,
      "required_role": "data"
    },
    {
      "source": {
        "role": "data",
        "suffix": "services/secrets/llm-api-key"
      },
      "target": "/run/secrets/llm-api-key",
      "read_only": true,
      "required_role": "data"
    },
    {
      "source": {
        "role": "data",
        "suffix": "services/llm-manager/adapters/sglang38_file_auth.py"
      },
      "target": "/opt/llmctl/sglang38_file_auth.py",
      "read_only": true,
      "required_role": "data"
    }
  ],
  "launch": {
    "context_size": 262144,
    "timeout_seconds": 7200,
    "warmup_timeout_seconds": 600,
    "poll_seconds": 5,
    "request_timeout_seconds": 5,
    "stop_timeout_seconds": 60,
    "gpus": [
      "0"
    ],
    "tp_size": 1,
    "tokenizer_worker_num": 1,
    "tool_call_parser": "qwen3_coder",
    "reasoning_parser": "qwen3",
    "max_running_requests": 1,
    "mem_fraction_static": 0.8,
    "load_format": "safetensors",
    "dtype": "bfloat16",
    "kv_cache_dtype": "bfloat16",
    "quantization": "fp8",
    "attention_backend": "flashinfer",
    "linear_attn_backend": "triton",
    "fp8_gemm_backend": "cutlass",
    "chunked_prefill_size": 2048,
    "max_total_tokens": 262144,
    "max_mamba_cache_size": 1,
    "mamba_radix_cache_strategy": "no_buffer",
    "disable_radix_cache": true,
    "cuda_graph_backend_decode": "disabled",
    "cuda_graph_backend_prefill": "disabled",
    "default_chat_template_kwargs": {
      "enable_thinking": false
    },
    "file_storage_path": "/cache/storage",
    "download_dir": "/cache/downloads",
    "base_gpu_id": 0,
    "gpu_id_step": 1,
    "mamba_ssm_dtype": "float32",
    "disable_overlap_schedule": true
  },
  "client_preset": {
    "id": "fast-no-thinking",
    "reasoning_effort": "none",
    "chat_template_kwargs": {
      "enable_thinking": false
    },
    "continuation_contract": "Replay assistant content/tool_calls and tool results. No reasoning replay required only while no-thinking is explicitly retained. Actual parser/client continuation NOT_TESTED.",
    "minimum_reserved_tokens": 8192
  },
  "logs": {
    "driver": "json-file",
    "max_size": "20m",
    "max_file": 3
  },
  "boot_policy": "manual",
  "docker_restart_policy": "no",
  "notes": [
    "Only one model/backend may be active. Same served alias and port make the two deployment identities mutually exclusive.",
    "Source-only planned role+suffix paths require canonical L1 registered mount binding before create/start/reuse; no implicit /data fallback.",
    "Native health and metrics GET probes are explicit keyless exceptions; ordinary HTTP requires native authentication and WebSockets are denied.",
    "Full checkpoint retained; text-only API. No MTP/speculation/RoPE extension/1M context; bounded native BF16 KV and linear cache.",
    "The no-thinking server default can be overridden by native per-request effort. Fast clients must use the explicit no-thinking request preset; validate serialized requests in actual agent gates.",
    "Configured context, source parser registration and memory arithmetic are not occupied-context, throughput or quality evidence."
  ]
}
