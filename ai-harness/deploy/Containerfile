# Build context: ai-harness/. No host home, credentials or engine vendor tree.
# Registry index verified 2026-09-22; linux/amd64 member is recorded in engine/pins.json.
FROM docker.io/library/node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS source-base
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@9.12.0
WORKDIR /build/minimax
RUN git init --quiet \
    && git remote add origin https://github.com/MiniMax-AI/minimax-code.git \
    && git fetch --depth=1 origin ae65651df5f97ae1085ab4e19964f4b78c769a4e \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = ae65651df5f97ae1085ab4e19964f4b78c769a4e

# Dependency inputs are isolated from all ACP/source patches and documentation.
FROM source-base AS source-deps
COPY deploy/patches/0003-gateway-undici-dependency.patch deploy/patches/dependency-source.SHA256SUMS deploy/patches/dependency-patched.SHA256SUMS /tmp/ai-harness-dependency/
RUN test "$(git rev-parse HEAD)" = ae65651df5f97ae1085ab4e19964f4b78c769a4e \
    && sha256sum -c /tmp/ai-harness-dependency/dependency-source.SHA256SUMS \
    && printf '%s\n' 'f1db7f0c33096b818ed5eea9b8899c0845e81ab74917eb98aec028a168c62c08  /tmp/ai-harness-dependency/0003-gateway-undici-dependency.patch' | sha256sum -c - \
    && git apply --check --whitespace=error --include=third_party/pi-mono/packages/ai/package.json --include=pnpm-lock.yaml /tmp/ai-harness-dependency/0003-gateway-undici-dependency.patch \
    && git apply --whitespace=error --include=third_party/pi-mono/packages/ai/package.json --include=pnpm-lock.yaml /tmp/ai-harness-dependency/0003-gateway-undici-dependency.patch \
    && sha256sum -c /tmp/ai-harness-dependency/dependency-patched.SHA256SUMS
RUN pnpm install --frozen-lockfile \
    && sha256sum -c /tmp/ai-harness-dependency/dependency-patched.SHA256SUMS

FROM source-deps AS build
COPY deploy/patches/*.patch deploy/patches/*SHA256SUMS /tmp/ai-harness-patches/
# Fail closed on upstream-file or patch drift before building the exact source.
RUN test "$(git rev-parse HEAD)" = ae65651df5f97ae1085ab4e19964f4b78c769a4e \
    && sha256sum -c /tmp/ai-harness-patches/source-source.SHA256SUMS \
    && sha256sum -c /tmp/ai-harness-patches/dependency-patched.SHA256SUMS \
    && cd /tmp/ai-harness-patches && sha256sum -c SHA256SUMS \
    && printf '%s\n' '00418190e3abae6ef9e44c60dedfda220d2a60fa9d64e364fa650d142362f8b7  SHA256SUMS' | sha256sum -c - \
    && cd /build/minimax \
    && for patch in /tmp/ai-harness-patches/[0-9]*.patch; do \
         if [[ "${patch##*/}" = 0003-gateway-undici-dependency.patch ]]; then continue; fi; \
         git apply --check --whitespace=error --exclude=third_party/pi-mono/packages/ai/package.json --exclude=pnpm-lock.yaml "$patch" \
           && git apply --whitespace=error --exclude=third_party/pi-mono/packages/ai/package.json --exclude=pnpm-lock.yaml "$patch" || exit; \
       done \
    && sha256sum -c /tmp/ai-harness-patches/patched.SHA256SUMS
# Upstream release packaging requires a clean committed tree. Commit only the
# verified patchset inside this build; retain both original and derived revisions.
RUN git add --all \
    && GIT_AUTHOR_DATE=2026-09-22T00:00:00Z GIT_COMMITTER_DATE=2026-09-22T00:00:00Z \
       git -c user.name='ai-harness source build' -c user.email='ai-harness-build@localhost' \
       commit --quiet --no-gpg-sign -m 'Apply identity-checked ai-harness deployment patches' \
    && test -z "$(git status --porcelain --untracked-files=no)"
# Frozen workspace lock; upstream verifies the external mcode-tools archive/CLI
# and carries its manifest/notices into the release. Never bypass these hashes.
RUN pnpm typecheck \
    && MCODE_RELEASE_TAG=v0.5.1 pnpm build \
    && node scripts/package-cli-release.mjs v0.5.1 /build/release \
    && cd /build/release && sha256sum -c minimax-code-0.5.1.tar.gz.sha256
# Runtime-only npm installation archive produced by the pinned source build.
RUN mkdir /opt/minimax \
    && tar -xzf /build/release/minimax-code-0.5.1.tar.gz -C /opt/minimax --strip-components=1 \
    && cd /opt/minimax \
    && npm install --omit=dev --include=optional --ignore-scripts=false \
    && node cli.js --version \
    && cp /build/minimax/pnpm-lock.yaml /opt/minimax/source-pnpm-lock.yaml \
    && git -C /build/minimax rev-parse HEAD > /opt/minimax/patched-source-revision.txt \
    && cp /build/release/*.sha256 /opt/minimax/ \
    && npm cache clean --force

FROM docker.io/library/node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS runtime-deps
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates curl git openssh-client ripgrep jq file unzip xz-utils \
      chromium chromium-sandbox fonts-liberation fonts-dejavu-core \
      poppler-utils tesseract-ocr tesseract-ocr-eng \
      python3 python3-venv python3-pip python3-pytest python3-numpy python3-scipy \
      python3-matplotlib python3-pandas python3-sympy \
      build-essential clang cmake ninja-build gdb pkg-config util-linux \
    && dpkg-query -W -f='${Package}\t${Version}\n' > /usr/local/share/ai-harness-dpkg.tsv \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/ai-harness-python \
    && /opt/ai-harness-python/bin/pip install --no-cache-dir \
      pypdf==6.1.1 pdfplumber==0.11.7 reportlab==4.4.4 \
    && /opt/ai-harness-python/bin/pip freeze > /usr/local/share/ai-harness-python.txt
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm install --global typescript@5.9.3 @playwright/test@1.56.1 \
    && npm list --global --depth=0 --json > /usr/local/share/ai-harness-npm.json \
    && npm cache clean --force
FROM runtime-deps AS runtime-base
LABEL org.opencontainers.image.title="ai-harness local MiniMax engine" \
      org.opencontainers.image.version="0.0.1" \
      org.opencontainers.image.revision="ae65651df5f97ae1085ab4e19964f4b78c769a4e" \
      org.opencontainers.image.ai-harness.patchset="00418190e3abae6ef9e44c60dedfda220d2a60fa9d64e364fa650d142362f8b7" \
      org.opencontainers.image.source="https://github.com/MiniMax-AI/minimax-code"
COPY --from=build /opt/minimax /opt/minimax
COPY deploy/patches /usr/local/share/ai-harness-patches
COPY deploy/engine /opt/ai-harness/engine
RUN mkdir -p /opt/ai-harness/bin \
    && ln -s ../engine/mcode-local /opt/ai-harness/bin/mcode-local \
    && chmod 0555 /opt/ai-harness/engine/mcode-local \
    && test -x /usr/bin/chromium \
    && test -s /opt/minimax/MCODE_TOOLS_NOTICES.md \
    && test -s /opt/minimax/embedded/mcode-tools/manifest.json \
    && printf '%s\n' 'e5a59ec5362e395b519317ad6fecd99f6e92308b9d985be44b64eb2f2b73a722  /opt/minimax/embedded/mcode-tools/cli.mjs' | sha256sum -c - \
    && node --check /opt/ai-harness/engine/configure-profile.mjs \
    && node --test /opt/ai-harness/engine/configure-profile.test.mjs
ENV PATH="/opt/ai-harness-python/bin:/opt/ai-harness/bin:/usr/local/bin:/usr/bin:/bin" \
    MCODE_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1 \
    MCODE_CHROME_PATH=/usr/bin/chromium PYTHONDONTWRITEBYTECODE=1
# Existing image user; no host account changes. Launcher uses keep-id and its UID.
USER 1000:1000
ENTRYPOINT ["/opt/ai-harness/bin/mcode-local"]

# Root integrates only reviewed TOOLS/SERVER assets in a later stage FROM runtime-base.
# Reserved image paths: /opt/ai-harness/tools and /opt/ai-harness/skills.
# Keep their COPY/install steps after runtime-base to reuse the pinned compile.
