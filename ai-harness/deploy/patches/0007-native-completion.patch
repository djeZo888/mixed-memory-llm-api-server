+function isGuard(value: unknown): value is NativeRunGuard {
+  if (
+    typeof value !== 'object' ||
+    value === null ||
+    !('schemaVersion' in value) ||
+    value.schemaVersion !== 1 ||
+    !('rootSessionId' in value) ||
+    typeof value.rootSessionId !== 'string' ||
+    !('runId' in value) ||
+    typeof value.runId !== 'string'
+  )
+    return false;
+  const record = value as Record<string, unknown>;
+  if (record.state !== undefined && !['interrupted', 'settled', 'cancelled'].includes(record.state as string))
+    return false;
+  const arrayKeys = ['baselineTurnIds', 'rootTurnIds', 'ownerSessionIds', 'taskIds'];
+  for (const key of arrayKeys) {
+    const field = record[key];
+    if (
+      field !== undefined &&
+      (!Array.isArray(field) || !field.every((id) => typeof id === 'string'))
