+    expect(held.has('root')).toBe(true);
+    for (const entry of entries) entry.metadata = { ...entry.metadata, completionDeliveryAcknowledged: true };
+  });
+  const fence = vi.fn(async (owner: string, operation: (signal?: AbortSignal) => Promise<unknown>) => {
+    if (active.has(owner)) return { acquired: false as const };
+    held.add(owner);
