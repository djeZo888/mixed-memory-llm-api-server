+  const active = new Map<string, { turnId: string; busyReason: 'turn'; locallyOwned: boolean }>();
+  const listeners = new Set<() => void>();
+  const held = new Set<string>();
+  const latch = vi.fn();
+  const rearm = vi.fn();
+  const drain = vi.fn(async (_owners: readonly string[]) => undefined);
+  const work = {
