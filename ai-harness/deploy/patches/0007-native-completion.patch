+function task(taskId: string, ownerSessionId = 'root', kind: BackgroundTask['kind'] = 'subagent'): BackgroundTask {
+  return { taskId, ownerSessionId, kind, status: 'succeeded', createdAt: 1, updatedAt: 2, endedAt: 2 };
+}
