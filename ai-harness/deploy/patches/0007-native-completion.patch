+interface NativeSettlementTestReceipt {
+  schemaVersion: 1;
+  instanceId: string;
+  rootSessionId: string;
+  runId: string;
+  exhaustive: boolean;
+  state: 'running' | 'settled' | 'cancelled' | 'unknown';
+  rootTurnIds: string[];
+  reasons: string[];
+}
+
+function nativeTestDeferred<T = void>() {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((complete) => {
+    resolve = complete;
+  });
+  return { promise, resolve };
+}
+
+/** A native snapshot fixture: only an explicit state publication releases a waiter. */
+function attachNativeSettlement(runtime: TuiAcpRuntime) {
+  let receipt: NativeSettlementTestReceipt = {
+    schemaVersion: 1,
+    instanceId: 'native-instance-1',
+    rootSessionId: 'session-1',
+    runId: 'turn-1',
+    exhaustive: true,
+    state: 'running',
+    rootTurnIds: ['turn-1'],
+    reasons: ['native runner pending'],
+  };
+  const waiting = new Set<() => void>();
+  const firstWait = nativeTestDeferred();
+  const snapshot = () => ({
+    ...receipt,
+    rootTurnIds: [...receipt.rootTurnIds],
+    reasons: [...receipt.reasons],
+  });
+  const publish = (patch: Partial<NativeSettlementTestReceipt>) => {
+    receipt = { ...receipt, ...patch };
+    for (const wake of waiting) wake();
+  };
+  const beginNativeRun = vi.fn(async (_sessionId: string, _runId: string) => snapshot());
+  const getNativeRunSettlement = vi.fn(
+    async (_sessionId: string, expected?: { instanceId?: string; runId?: string }) => {
+      if (
+        (expected?.instanceId && expected.instanceId !== receipt.instanceId) ||
+        (expected?.runId && expected.runId !== receipt.runId)
+      ) {
+        return {
+          ...snapshot(),
+          state: 'unknown' as const,
+          exhaustive: false,
+          reasons: ['stale identity'],
+        };
+      }
+      return snapshot();
+    },
+  );
+  const waitNativeRunSettlement = vi.fn(
+    async (
+      _sessionId: string,
+      _runId: string,
+      afterRootTurnIds: readonly string[],
+      signal: AbortSignal,
+    ) => {
+      firstWait.resolve();
+      return new Promise<NativeSettlementTestReceipt>((resolve) => {
+        const wake = () => {
+          if (
+            !signal.aborted &&
+            receipt.state === 'running' &&
+            receipt.rootTurnIds.every((turnId) => afterRootTurnIds.includes(turnId))
+          )
+            return;
+          waiting.delete(wake);
+          signal.removeEventListener('abort', wake);
+          resolve(snapshot());
+        };
+        waiting.add(wake);
+        signal.addEventListener('abort', wake, { once: true });
+        wake();
+      });
+    },
+  );
+  const cancelNativeRun = vi.fn(async (_sessionId: string, _runId?: string) => {
+    publish({ state: 'cancelled', exhaustive: true, reasons: [] });
+    return snapshot();
+  });
+  Object.assign(runtime, {
+    beginNativeRun,
+    getNativeRunSettlement,
+    waitNativeRunSettlement,
+    cancelNativeRun,
+  });
+  return {
+    beginNativeRun,
+    getNativeRunSettlement,
+    waitNativeRunSettlement,
+    cancelNativeRun,
+    firstWait: firstWait.promise,
+    snapshot,
+    publish,
+  };
+}
