+        if (!rearmStarted) {
+          rearmStarted = true;
+          sendCompletion(res, { role: "assistant", tool_calls: [toolCall("task", {
+            description: "Fresh synthetic child after resume",
+            prompt: "NATIVE_CHILD_C: return a short synthetic result; do not use tools.",
+            agent_name: "worker", run_in_background: true,
+          }, 0)] }, "tool_calls");
+          return;
+        }
+        const freshNotices = [...messages.matchAll(/<task task_id=\\"([^\\"]+)\\"/gu)].map((match) => match[1]);
+        const unreadFresh = [...new Set(freshNotices)].filter((id) => !outputRequested.has(id));
+        if (unreadFresh.length) {
+          for (const id of unreadFresh) outputRequested.add(id);
+          sendCompletion(res, { role: "assistant", tool_calls: unreadFresh.map((taskId, index) => toolCall("task_output", { task_id: taskId }, index)) }, "tool_calls");
+          return;
+        }
+        sendCompletion(res, { role: "assistant", content: messages.includes("NATIVE_CHILD_C_RESULT") ? rearmFinalText : "NATIVE_REARM_PREAMBLE" });
+        return;
+      }
+      if (!rootStarted) {
+        rootStarted = true;
+        assert.ok(body.tools?.some((tool) => tool.function?.name === "task"), "Root exposes the native task tool");
+        sendCompletion(res, { role: "assistant", tool_calls: ["A", "B"].map((marker, index) => toolCall("task", {
+          description: `Synthetic child ${marker}`,
+          prompt: `NATIVE_CHILD_${marker}: return a short synthetic result; do not use tools.`,
+          agent_name: "worker", run_in_background: true,
+        }, index)) }, "tool_calls");
+        return;
+      }
+      const noticeTaskIds = [...messages.matchAll(/<task task_id=\\"([^\\"]+)\\"/gu)].map((match) => match[1]);
+      const unread = [...new Set(noticeTaskIds)].filter((id) => !outputRequested.has(id));
+      if (unread.length) {
+        for (const id of unread) outputRequested.add(id);
+        sendCompletion(res, { role: "assistant", tool_calls: unread.map((taskId, index) => toolCall("task_output", { task_id: taskId }, index)) }, "tool_calls");
+        return;
+      }
+      if (messages.includes("NATIVE_CHILD_A_RESULT") && messages.includes("NATIVE_CHILD_B_RESULT")) {
+        finalRequested.resolve();
+        await releaseFinal.promise;
+        sendCompletion(res, { role: "assistant", content: finalText });
+      } else {
+        sendCompletion(res, { role: "assistant", content: outputRequested.size ? "NATIVE_ROOT_PARTIAL" : preamble });
+      }
+    } catch (error) {
+      serverError = error;
+      childrenRequested.resolve(); preambleObserved.resolve(); finalRequested.resolve();
+      res.writeHead(500).end();
+    }
+  });
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const origin = `http://127.0.0.1:${server.address().port}`;
+  t.after(async () => {
+    clearTimeout(deadline);
+    releaseChildren.resolve();
+    releaseFinal.resolve();
+    if (child && child.exitCode === null && child.signalCode === null) {
+      const closed = once(child, "close");
+      child.kill("SIGKILL");
+      await closed;
+    }
+    server.closeAllConnections();
+    await new Promise((resolve) => server.close(resolve));
+    try {
+      assert.equal(existsSync(networkAudit), false, existsSync(networkAudit) ? readFileSync(networkAudit, "utf8") : "No external network attempts");
+    } finally {
+      rmSync(fixtureDir, { recursive: true, force: true });
+    }
+  });
+  writeFileSync(path.join(dataDir, "config.yaml"), stringifyYaml({
+    defaultModel: "custom_provider:fixture/fixture",
+    custom_provider: { fixture: {
+      name: "fixture", kind: "custom", enabled: true, api: "openai-completions",
+      options: { apiKey: "synthetic-key", baseURL: `${origin}/v1`, authMode: "api-key" },
+      models: { fixture: { limit: { context: 32768, output: 4096 } } },
+    } },
+  }));
+  const failPending = (error) => { for (const waiter of pending.values()) waiter.reject(error); pending.clear(); };
+  const startClient = () => {
+  child = spawn(process.execPath, [cli, "acp"], {
+    cwd: workspaceDir,
+    env: {
+      ...withoutProxyEnvironment(process.env),
+      HOME: homeDir, XDG_CONFIG_HOME: path.join(homeDir, "config"), XDG_DATA_HOME: path.join(homeDir, "data"),
+      MINIMAX_DATA_DIR: dataDir, MAVIS_DATA_DIR: dataDir,
+      MCODE_TEST_ALLOWED_ORIGIN: origin, MCODE_TEST_NETWORK_AUDIT: networkAudit,
+      MCODE_TEST_MANAGED_OFFLINE: "1",
+      NODE_OPTIONS: `--import=${new URL("./network-deny.mjs", import.meta.url).href}`,
+    },
+    stdio: ["pipe", "pipe", "pipe"],
+  });
+  child.stderr.on("data", (chunk) => { stderr += chunk; });
+  child.on("error", failPending);
+  child.on("exit", (code, signal) => failPending(new Error(`ACP exited ${code}/${signal}: ${stderr}`)));
+  let buffer = "";
+  child.stdout.on("data", (chunk) => {
+    buffer += chunk;
+    while (buffer.includes("\n")) {
+      const index = buffer.indexOf("\n");
+      const line = buffer.slice(0, index);
+      buffer = buffer.slice(index + 1);
+      try {
+        const message = JSON.parse(line);
+        if (message.id !== undefined && pending.has(message.id)) {
+          const waiter = pending.get(message.id);
+          pending.delete(message.id);
+          if (message.error) waiter.reject(new Error(JSON.stringify(message.error)));
+          else waiter.resolve(message.result);
+        } else if (message.method === "session/update") {
+          notifications.push(message.params);
+          const update = message.params.update;
+          if (update.sessionUpdate === "agent_message_chunk" && update.content?.text?.includes(preamble)) preambleObserved.resolve();
+        } else if (message.id !== undefined && message.method === "session/request_permission") {
+          const allow = message.params.options.find((option) => option.kind === "allow_once" || option.kind === "allow_always");
+          assert.ok(allow, "Synthetic task tool permission must have an allow choice");
+          child.stdin.write(JSON.stringify({ jsonrpc: "2.0", id: message.id, result: { outcome: { outcome: "selected", optionId: allow.optionId } } }) + "\n");
+        }
+      } catch (error) { failPending(error); }
+    }
+  });
+  };
+  startClient();
+  const rpc = (method, params) => new Promise((resolve, reject) => {
+    if (deadlineError || child.exitCode !== null || child.signalCode !== null) {
+      reject(deadlineError ?? new Error(`ACP already exited: ${stderr}`));
+      return;
+    }
+    const id = nextRpcId++;
+    pending.set(id, { resolve, reject });
+    child.stdin.write(JSON.stringify({ jsonrpc: "2.0", id, method, params }) + "\n");
+  });
+  deadline = setTimeout(() => {
+    deadlineError = new Error(`ACP native fixture deadline: ${stderr}\nserverError=${serverError?.stack}\nrequests=${requests.length}; children=${[...childMarkers]}; outputs=${[...outputRequested]}`);
+    failPending(deadlineError);
+    childrenRequested.resolve(); preambleObserved.resolve(); finalRequested.resolve();
+    child.kill("SIGKILL");
+  }, 45000);
+  const initialized = await rpc("initialize", { protocolVersion: 1, clientCapabilities: {}, clientInfo: { name: "native-settlement-fixture", version: "1" } });
+  assert.ok(initialized._meta?.["minimax-code/extensions"]?.methods?.includes("mcode/session/settlement/get"));
+  const session = await rpc("session/new", { cwd: workspaceDir, mcpServers: [] });
+  let promptReturned = false;
+  const prompt = rpc("session/prompt", { sessionId: session.sessionId, prompt: [{ type: "text", text: rootMarker }] });
+  // Attach rejection handling immediately while the fixture waits on native admission events.
+  const promptOutcome = prompt.then((value) => { promptReturned = true; return { value }; }, (error) => { promptReturned = true; return { error }; });
+  await Promise.race([
+    Promise.all([childrenRequested.promise, preambleObserved.promise]),
+    promptOutcome.then((outcome) => { throw outcome.error ?? new Error("ACP prompt returned before native child settlement"); }),
+  ]);
+  if (deadlineError) throw deadlineError;
+  assert.equal(serverError, undefined, serverError?.stack);
+  assert.equal(childMarkers.size, 2, "Two native child providers must be active in parallel");
+  assert.equal(promptReturned, false, "Initial root text must not settle the original ACP prompt");
+  const dbPath = path.join(dataDir, "v2", "sqlite", "runtime-state.sqlite");
+  const db = new Database(dbPath, { readonly: true });
+  try {
+    // Yield only to observe a specific durable completed row and released lease; elapsed time is not proof.
+    while (true) {
+      const initial = db.prepare("SELECT turn_id, status FROM local_runtime_turn_ingress WHERE session_id = ? AND source = 'turn' ORDER BY accepted_sequence LIMIT 1").get(session.sessionId);
+      const locked = db.prepare("SELECT 1 FROM local_runtime_session_locks WHERE session_id = ?").get(session.sessionId);
+      if (initial?.status === "completed" && !locked) break;
+      if (deadlineError) throw deadlineError;
+      assert.equal(child.exitCode, null, `ACP exited before initial native release: ${stderr}`);
+      assert.equal(child.signalCode, null, `ACP was terminated before initial native release: ${stderr}`);
+      await new Promise((resolve) => setImmediate(resolve));
+    }
+  } finally { db.close(); }
+  const duringChildren = (await rpc("mcode/session/settlement/get", { sessionId: session.sessionId })).receipt;
+  assert.equal(duringChildren.state, "running");
+  assert.equal(duringChildren.exhaustive, true);
+  if (scenario === "interruption-restart") {
+    const oldClosed = once(child, "close");
+    child.kill("SIGKILL");
+    assert.equal((await oldClosed)[1], "SIGKILL");
+    assert.ok((await promptOutcome).error, "Interrupted transport cannot return a successful prompt receipt");
+    releaseChildren.resolve();
+    await oldChildrenResponded.promise;
+    const streamRequestsBeforeRestart = requests.filter((request) => request.stream).length;
+    startClient();
+    await rpc("initialize", { protocolVersion: 1, clientCapabilities: {} });
+    await rpc("session/load", { sessionId: session.sessionId, cwd: workspaceDir, mcpServers: [] });
+    const restored = (await rpc("mcode/session/settlement/get", { sessionId: session.sessionId })).receipt;
+    assert.equal(restored.state, "unknown", "Interrupted native work must not become a clean run after process restart");
+    assert.equal(restored.exhaustive, false);
+    assert.equal(restored.runId, duringChildren.runId);
+    assert.notEqual(restored.instanceId, duringChildren.instanceId);
+    assert.ok(restored.reasons.includes("interrupted_native_run"));
+    await assert.rejects(rpc("session/prompt", { sessionId: session.sessionId, prompt: [{ type: "text", text: rearmMarker }] }), /settlement/u);
+    assert.equal(requests.filter((request) => request.stream).length, streamRequestsBeforeRestart,
+      "Unknown restart cannot replay old notices or admit a fresh provider turn");
+    const durable = new Database(dbPath, { readonly: true });
+    try {
+      const rootTurns = durable.prepare("SELECT turn_id FROM local_runtime_turn_ingress WHERE session_id = ?").all(session.sessionId);
+      assert.equal(rootTurns.length, 1, "Interrupted task delivery cannot silently create a root continuation on load");
+      const taskRows = durable.prepare("SELECT record_json FROM local_runtime_background_tasks").all().map((row) => JSON.parse(row.record_json));
+      assert.equal(taskRows.filter((row) => row.metadata?.completionDeliverySuppressed).length, 2,
+        "Persisted old tasks are suppressed before interrupted session load");
+    } finally { durable.close(); }
+    const closed = once(child, "close");
+    child.stdin.end();
+    assert.equal((await closed)[0], 0, stderr);
+    clearTimeout(deadline);
+    return;
+  }
+  if (scenario.startsWith("cancel-")) {
+    // Cancel while two native providers are held. Provider callbacks are then released only after
+    // native cancellation proves their runner/delivery chain has drained.
+    child.stdin.write(JSON.stringify({ jsonrpc: "2.0", method: "session/cancel", params: { sessionId: session.sessionId } }) + "\n");
+    const cancelledOutcome = await promptOutcome;
+    if (cancelledOutcome.error) throw cancelledOutcome.error;
+    assert.equal(cancelledOutcome.value.stopReason, "cancelled");
+    const cancelled = cancelledOutcome.value._meta?.["minimax-code/settlement"];
+    assert.equal(cancelled.state, "cancelled");
+    assert.equal(cancelled.exhaustive, true);
+    assert.equal(cancelled.runId, duringChildren.runId);
+    releaseChildren.resolve();
+    await oldChildrenResponded.promise;
+    if (scenario === "cancel-restart-rearm") {
+      const oldClosed = once(child, "close");
+      child.stdin.end();
+      assert.equal((await oldClosed)[0], 0, stderr);
+      startClient();
+      await rpc("initialize", { protocolVersion: 1, clientCapabilities: {} });
+      await rpc("session/load", { sessionId: session.sessionId, cwd: workspaceDir, mcpServers: [] });
+      const restored = (await rpc("mcode/session/settlement/get", { sessionId: session.sessionId })).receipt;
+      assert.equal(restored.state, "cancelled", "Clean cancelled guard is distinguishable from crash/unknown on restart");
+      assert.equal(restored.exhaustive, true);
+      assert.notEqual(restored.instanceId, cancelled.instanceId);
+      assert.equal(restored.runId, cancelled.runId);
+    }
+    const newResponse = await rpc("session/prompt", { sessionId: session.sessionId, prompt: [{ type: "text", text: rearmMarker }] });
+    assert.equal(newResponse.stopReason, "end_turn");
+    const next = newResponse._meta?.["minimax-code/settlement"];
+    assert.equal(next.state, "settled");
+    assert.equal(next.exhaustive, true);
+    assert.equal(next.rootSessionId, session.sessionId);
+    assert.notEqual(next.runId, cancelled.runId, "Explicit next prompt has a fresh native run identity");
+    assert.ok(childMarkers.has("C"), "Fresh background child runs after same-root rearming");
+    assert.ok(notifications.some(({ update }) => update.sessionUpdate === "agent_message_chunk" && update.content?.text?.includes(rearmFinalText)));
+    const durable = new Database(dbPath, { readonly: true });
+    try {
+      const rootTurns = durable.prepare("SELECT turn_id, source FROM local_runtime_turn_ingress WHERE session_id = ? ORDER BY accepted_sequence").all(session.sessionId);
+      const newRunIndex = rootTurns.findIndex((row) => row.turn_id === next.runId);
+      assert.equal(newRunIndex, 1, "Old cancelled child completion callbacks cannot spawn an owner turn before the explicit new prompt");
+      const taskRows = durable.prepare("SELECT record_json FROM local_runtime_background_tasks").all().map((row) => JSON.parse(row.record_json));
+      assert.equal(taskRows.filter((row) => row.metadata?.completionDeliverySuppressed).length, 2, "Old tasks remain durably suppressed after rearming");
+    } finally { durable.close(); }
+    assert.deepEqual((await rpc("mcode/session/settlement/get", { sessionId: session.sessionId, instanceId: next.instanceId, runId: next.runId })).receipt, next);
+    const closed = once(child, "close");
+    child.stdin.end();
+    assert.equal((await closed)[0], 0, stderr);
+    clearTimeout(deadline);
+    return;
+  }
+  releaseChildren.resolve();
+  await Promise.race([
+    finalRequested.promise,
+    promptOutcome.then((outcome) => { throw outcome.error ?? new Error("ACP prompt returned before final root provider completion"); }),
+  ]);
+  if (deadlineError) throw deadlineError;
+  assert.equal(serverError, undefined, serverError?.stack);
+  assert.equal(outputRequested.size, 2, "Resumed native root must read both child outputs");
+  assert.equal(promptReturned, false, "Delivery acknowledgement is not root completion");
+  const duringFinal = (await rpc("mcode/session/settlement/get", { sessionId: session.sessionId, instanceId: duringChildren.instanceId, runId: duringChildren.runId })).receipt;
+  assert.equal(duringFinal.state, "running");
+  releaseFinal.resolve();
+  const outcome = await promptOutcome;
+  if (outcome.error) throw outcome.error;
+  assert.equal(outcome.value.stopReason, "end_turn");
+  const receipt = outcome.value._meta?.["minimax-code/settlement"];
+  assert.equal(receipt.schemaVersion, 1);
+  assert.equal(receipt.instanceId, duringChildren.instanceId);
+  assert.equal(receipt.runId, duringChildren.runId);
+  assert.equal(receipt.rootSessionId, session.sessionId);
+  assert.equal(receipt.state, "settled");
+  assert.equal(receipt.exhaustive, true);
+  assert.ok(receipt.rootTurnIds.length >= 2, "Native receipt covers the initial and resumed root turns");
+  assert.deepEqual(receipt.reasons, []);
+  const rootText = notifications.filter(({ update }) => update.sessionUpdate === "agent_message_chunk").map(({ update }) => update.content?.text ?? "").join("");
+  assert.ok(rootText.includes(finalText), `Final native ROOT text must precede prompt response: ${rootText}`);
+  assert.equal(rootText.includes("NATIVE_CHILD_A_RESULT"), false, "Child text is tool progress, not final assistant text");
+  assert.equal(rootText.includes("NATIVE_CHILD_B_RESULT"), false, "Child text is tool progress, not final assistant text");
+  assert.deepEqual((await rpc("mcode/session/settlement/get", { sessionId: session.sessionId, instanceId: receipt.instanceId, runId: receipt.runId })).receipt, receipt);
+  const closed = once(child, "close");
+  child.stdin.end();
+  const [code] = await closed;
+  assert.equal(code, 0, stderr);
+  if (scenario === "completion-restart") {
+    startClient();
+    await rpc("initialize", { protocolVersion: 1, clientCapabilities: {} });
+    await rpc("session/load", { sessionId: session.sessionId, cwd: workspaceDir, mcpServers: [] });
+    const restored = (await rpc("mcode/session/settlement/get", { sessionId: session.sessionId })).receipt;
+    assert.equal(restored.state, "settled", "Clean successful native history restores authoritative proof before the next prompt");
+    assert.equal(restored.exhaustive, true);
+    assert.equal(restored.runId, receipt.runId);
+    assert.equal(restored.rootSessionId, session.sessionId);
+    assert.deepEqual(restored.rootTurnIds, receipt.rootTurnIds);
+    assert.notEqual(restored.instanceId, receipt.instanceId);
+    assert.equal((await rpc("mcode/session/settlement/get", { sessionId: session.sessionId, instanceId: receipt.instanceId })).receipt.state, "unknown");
+    const nextResponse = await rpc("session/prompt", { sessionId: session.sessionId, prompt: [{ type: "text", text: rearmMarker }] });
+    const next = nextResponse._meta?.["minimax-code/settlement"];
+    assert.equal(nextResponse.stopReason, "end_turn");
+    assert.equal(next.state, "settled");
+    assert.equal(next.exhaustive, true);
+    assert.equal(next.rootSessionId, session.sessionId);
+    assert.notEqual(next.runId, receipt.runId, "Same loaded native session admits an explicit new run");
+    assert.ok(childMarkers.has("C"), "A loaded settled root can launch fresh native background work");
+    assert.ok(notifications.some(({ update }) => update.sessionUpdate === "agent_message_chunk" && update.content?.text?.includes(rearmFinalText)));
+    assert.deepEqual((await rpc("mcode/session/settlement/get", { sessionId: session.sessionId, instanceId: next.instanceId, runId: next.runId })).receipt, next);
+    const resumedClosed = once(child, "close");
+    child.stdin.end();
+    assert.equal((await resumedClosed)[0], 0, stderr);
+  }
+  clearTimeout(deadline);
+});
+
+}
