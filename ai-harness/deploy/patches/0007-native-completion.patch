+    delivery: {
+      pendingTaskIds: [] as string[], lookupTaskIds: [] as string[], unscopedLookupTaskIds: [] as string[],
+      inFlightOwnerSessionIds: [] as string[], acknowledgedTaskIds: [] as string[], closed: false,
+    },
+  };
+  const emit = () => { work.runners.revision++; for (const listener of [...listeners]) listener(); };
+  const subscribe = (listener: () => void) => { listeners.add(listener); return () => { listeners.delete(listener); }; };
+  const inspect = vi.fn(() => work);
+  const list = vi.fn(async (owner: string) => tasks.filter((entry) => entry.ownerSessionId === owner));
+  const suppress = vi.fn(async (entries: readonly BackgroundTask[]) => {
+    for (const entry of entries) entry.metadata = { ...entry.metadata, completionDeliverySuppressed: true };
+  });
