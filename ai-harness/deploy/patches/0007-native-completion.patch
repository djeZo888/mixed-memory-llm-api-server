+export async function createNativeRunSettlement(input: {
+  readonly db: AppDb;
+  readonly dataDir: string;
+  readonly turns: NativeSettlementEvidence['turns'];
+  readonly background: NativeBackgroundSettlement;
+  readonly subscribe: NativeSettlementEvidence['subscribe'];
+}): Promise<NativeRunSettlement> {
+  const service = new NativeRunSettlementService(
+    {
+      turns: input.turns,
+      background: input.background,
+      subscribe: input.subscribe,
+      tree(rootSessionId) {
+        const rows = input.db
+          .select({
+            id: sessions.sessionId,
+            parent: sessions.parentSessionId,
+            version: sessions.columnarVersion,
+          })
+          .from(sessions)
+          .all();
+        if (!rows.some((row) => row.id === rootSessionId))
+          throw new Error('Native root session missing');
+        // Parent columns are authoritative only after the repository's existing v3 migration.
+        if (rows.some((row) => row.version !== 3))
+          throw new Error('Native session enumeration incomplete');
+        const ids = new Set([rootSessionId]);
+        let changed = true;
+        while (changed) {
+          changed = false;
+          for (const row of rows)
+            if (row.parent && ids.has(row.parent) && !ids.has(row.id)) {
+              ids.add(row.id);
+              changed = true;
+            }
+        }
+        return [...ids];
+      },
+      rootTurns(rootSessionId) {
+        return input.db
+          .select({
+            turnId: turnIngress.turnId,
+            status: turnIngress.status,
+            acceptedSequence: turnIngress.acceptedSequence,
+          })
+          .from(turnIngress)
+          .where(and(eq(turnIngress.sessionId, rootSessionId), eq(turnIngress.busyReason, 'turn')))
+          .orderBy(asc(turnIngress.acceptedSequence))
+          .all();
+      },
+      pauseQueue(sessionIds, runId) {
+        for (const sessionId of sessionIds)
+          input.db
+            .insert(queuePauses)
+            .values({
+              sessionId,
+              cause: 'user-stop',
+              triggerTurnId: runId,
+              pausedAtMs: Date.now(),
+            })
+            .onConflictDoUpdate({
+              target: queuePauses.sessionId,
+              set: {
+                cause: 'user-stop',
+                triggerTurnId: runId,
+                pausedAtMs: Date.now(),
+              },
+            })
+            .run();
+      },
+      pendingQueue(sessionIds) {
+        return input.db
+          .select({ id: queueItems.id })
+          .from(queueItems)
+          .where(
+            and(
+              inArray(queueItems.sessionId, [...sessionIds]),
+              inArray(queueItems.status, ['queued', 'claimed']),
+            ),
+          )
+          .all().length;
+      },
+    },
+    input.dataDir,
+  );
+  await service.restoreInterruptedRuns();
+  return service;
+}
