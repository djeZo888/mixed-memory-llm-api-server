diff --git a/packages/tui/src/acp/native-settlement.ts b/packages/tui/src/acp/native-settlement.ts
new file mode 100644
index 0000000..6f1989e
--- /dev/null
+++ b/packages/tui/src/acp/native-settlement.ts
@@ -0,0 +1,132 @@
+import * as acp from '@agentclientprotocol/sdk';
+
+import type { TuiNativeRunReceipt, TuiNativeSettlementPort } from '../runtime/port.js';
+import type { TuiStreamEvent } from '../runtime/stream-events.js';
+import type { TuiAcpRuntime } from './runtime.js';
+
+export const TUI_ACP_SETTLEMENT_METHOD = 'mcode/session/settlement/get';
+
+export function hasTuiNativeSettlement(
+  runtime: TuiNativeSettlementPort,
+): runtime is Required<TuiNativeSettlementPort> {
+  return (
+    typeof runtime.beginNativeRun === 'function' &&
+    typeof runtime.getNativeRunSettlement === 'function' &&
+    typeof runtime.waitNativeRunSettlement === 'function' &&
+    typeof runtime.cancelNativeRun === 'function'
+  );
+}
+
+export function parseNativeSettlementRequest(value: unknown): {
+  sessionId: string;
+  instanceId?: string;
+  runId?: string;
+} {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    throw acp.RequestError.invalidParams(undefined, 'Settlement params must be an object.');
+  }
+  const params = value as Record<string, unknown>;
+  const read = (key: string, required = false): string | undefined => {
+    const entry = params[key];
+    if (entry === undefined && !required) return undefined;
+    if (typeof entry !== 'string' || !entry.trim()) {
+      throw acp.RequestError.invalidParams(undefined, `${key} must be a non-empty string.`);
+    }
+    return entry;
+  };
+  const sessionId = read('sessionId', true)!;
+  const instanceId = read('instanceId');
+  const runId = read('runId');
+  return { sessionId, ...(instanceId ? { instanceId } : {}), ...(runId ? { runId } : {}) };
+}
+
+export function assertNativeRunIdentity(
+  receipt: TuiNativeRunReceipt,
+  expected: { rootSessionId: string; runId: string; instanceId?: string },
+): void {
+  if (
+    receipt.schemaVersion !== 1 ||
+    receipt.rootSessionId !== expected.rootSessionId ||
+    receipt.runId !== expected.runId ||
+    (expected.instanceId !== undefined && receipt.instanceId !== expected.instanceId)
+  ) {
+    throw new Error('Native settlement identity changed.');
+  }
+  if (receipt.state === 'unknown') {
+    throw new Error(`Native settlement is unknown: ${receipt.reasons.join(', ')}`);
+  }
+}
+
+/** Read retained ROOT turns, then ask native ownership for another proof/change. */
+export async function followNativeRun(options: {
+  runtime: TuiAcpRuntime & Required<TuiNativeSettlementPort>;
+  initial: TuiNativeRunReceipt;
+  runId: string;
+  signal: AbortSignal;
+  streamedTurnIds: Set<string>;
+  onSessionEvent: (event: TuiStreamEvent) => void;
+  onSteerableTurnChange: (turnId: string | undefined) => void;
+  onReceipt: (receipt: TuiNativeRunReceipt) => void;
+}): Promise<TuiNativeRunReceipt> {
+  const expected = {
+    rootSessionId: options.initial.rootSessionId,
+    runId: options.runId,
+    instanceId: options.initial.instanceId,
+  };
+  let receipt = await options.runtime.getNativeRunSettlement(expected.rootSessionId, expected);
+  while (true) {
+    options.onReceipt(receipt);
+    assertNativeRunIdentity(receipt, expected);
+    if (options.signal.aborted) throw options.signal.reason;
+    for (const turnId of receipt.rootTurnIds) {
+      if (options.streamedTurnIds.has(turnId)) continue;
+      options.streamedTurnIds.add(turnId);
+      options.onSteerableTurnChange(turnId);
+      let terminal = false;
+      try {
+        for await (const event of options.runtime.watchSessionTurn(
+          expected.rootSessionId,
+          turnId,
+          options.signal,
+        )) {
+          const eventTurnId = event.type === 'message' ? event.message.turnId : event.turnId;
+          if (eventTurnId && eventTurnId !== turnId) {
+            throw new Error('Native settlement replay returned a different turn.');
+          }
+          if (event.type === 'resync-required') {
+            throw new Error('Native settlement replay is incomplete.');
+          }
+          options.onSessionEvent(event);
+          if (
+            event.type === 'error' ||
+            (event.type === 'session-status' &&
+              ['error', 'aborted', 'interrupted'].includes(event.status))
+          ) {
+            throw new Error('Native settlement continuation did not finish normally.');
+          }
+          if (
+            event.type === 'done' ||
+            (event.type === 'session-status' && event.status === 'finished')
+          ) {
+            terminal = true;
+            break;
+          }
+        }
+      } finally {
+        options.onSteerableTurnChange(undefined);
+      }
+      if (options.signal.aborted) throw options.signal.reason;
+      if (!terminal) throw new Error('Native settlement replay ended without a terminal event.');
+    }
+    if (receipt.state !== 'running') {
+      if (!receipt.exhaustive) throw new Error('Native settlement proof is not exhaustive.');
+      return receipt;
+    }
+    receipt = await options.runtime.waitNativeRunSettlement(
+      expected.rootSessionId,
+      options.runId,
+      [...options.streamedTurnIds],
+      options.signal,
+    );
+  }
+}
