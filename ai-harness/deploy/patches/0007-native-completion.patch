@@ -0,0 +1,119 @@
+import { describe, expect, it } from 'vitest';
+import { SessionStreamService } from '../../../src/service/session-system/stream/session-stream-service.js';
+import type { SessionFrame } from '../../../src/service/session-system/stream/session-frame.js';
+import type { DisplayMessageRecord, MessageReplayResult } from '../../../src/service/session-system/messages/index.js';
+
+const message = (turnId: string, text = turnId): DisplayMessageRecord => ({
+  msg_id: `message-${turnId}`, role: 'assistant', turnId, content: text,
+});
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((done) => { resolve = done; });
+  return { promise, resolve };
+}
+async function collect(source: AsyncIterable<SessionFrame>): Promise<SessionFrame[]> {
+  const frames: SessionFrame[] = [];
+  for await (const frame of source) frames.push(frame);
+  return frames;
+}
+function terminal(stream: SessionStreamService, turnId: string): void {
+  stream.write({ sessionId: 'root', turnId, identity: `terminal-${turnId}`,
+    kind: 'turn-terminal', data: { status: 'completed' } });
+}
+function committed(stream: SessionStreamService, turnId: string): void {
+  stream.write({ sessionId: 'root', turnId, identity: `committed-${turnId}`,
+    kind: 'message-committed', data: { messages: [message(turnId)] } });
+}
+
+describe('specific native turn replay', () => {
+  it('replays a completed root continuation after the original process retained frames are gone', async () => {
+    const stream = new SessionStreamService({
+      messages: { listAfter: async () => ({ status: 'ok', messages: [message('first'), message('followup')] }) },
+      turnStatus: () => 'completed',
+    });
+    const frames = await collect(stream.resume({ sessionId: 'root', turnId: 'followup' }));
+    expect(frames.map((frame) => frame.kind)).toEqual(['durable-message', 'turn-terminal']);
+    expect(frames.every((frame) => frame.turnId === 'followup')).toBe(true);
+    expect(frames[0]?.data).toEqual(message('followup'));
+    stream.dispose();
+  });
+
+  it('selects the earlier completed root when a later continuation has also finished', async () => {
+    const stream = new SessionStreamService({
+      messages: { listAfter: async () => ({ status: 'ok', messages: [message('first'), message('second')] }) },
+      turnStatus: () => 'completed',
+    });
+    committed(stream, 'first'); terminal(stream, 'first');
+    committed(stream, 'second'); terminal(stream, 'second');
+    const frames = await collect(stream.resume({ sessionId: 'root', turnId: 'first' }));
+    expect(frames.map((frame) => frame.turnId)).toEqual(['first', 'first']);
+    expect(frames.filter((frame) => frame.kind === 'turn-terminal')).toHaveLength(1);
+    stream.dispose();
+  });
+
+  it('captures a root completing while the durable replay lookup is pending without duplication', async () => {
+    const read = deferred<MessageReplayResult>();
+    const stream = new SessionStreamService({ messages: { listAfter: () => read.promise }, turnStatus: () => 'completed' });
+    const source = stream.resume({ sessionId: 'root', turnId: 'followup' });
+    committed(stream, 'followup'); terminal(stream, 'followup');
+    committed(stream, 'other'); terminal(stream, 'other');
+    read.resolve({ status: 'ok', messages: [message('followup'), message('other')] });
+    const frames = await collect(source);
+    expect(frames.map((frame) => frame.kind)).toEqual(['durable-message', 'turn-terminal']);
+    expect(frames.map((frame) => frame.turnId)).toEqual(['followup', 'followup']);
+    stream.dispose();
+  });
+
+  it('does not leak other turns through a replacement that arrives during durable lookup', async () => {
+    const read = deferred<MessageReplayResult>();
+    const stream = new SessionStreamService({ messages: { listAfter: () => read.promise }, turnStatus: () => 'completed' });
+    const source = stream.resume({ sessionId: 'root', turnId: 'followup' });
+    stream.write({ sessionId: 'root', turnId: 'followup', identity: 'replacement',
+      kind: 'messages-replaced', data: { messages: [message('first'), message('followup'), message('other')] } });
+    terminal(stream, 'followup');
+    read.resolve({ status: 'ok', messages: [message('first')] });
+    const frames = await collect(source);
+    expect(frames.filter((frame) => frame.kind === 'durable-message').map((frame) => frame.data)).toEqual([message('followup')]);
+    expect(frames.every((frame) => frame.turnId === 'followup')).toBe(true);
+    stream.dispose();
+  });
+
+  it('filters live replacement payloads as well as their outer turn identity', async () => {
+    const stream = new SessionStreamService({ messages: { listAfter: async () => ({ status: 'ok', messages: [message('followup')] }) }, turnStatus: () => 'accepted' });
+    const source = stream.resume({ sessionId: 'root', turnId: 'followup' });
+    expect((await source.next()).value?.kind).toBe('durable-message');
+    stream.write({ sessionId: 'root', turnId: 'followup', identity: 'live-replacement',
+      kind: 'messages-replaced', data: { messages: [message('first'), message('followup')] } });
+    terminal(stream, 'followup');
+    const frames = await collect(source);
+    expect(frames[0]?.data).toEqual({ messages: [message('followup')] });
+    expect(frames.at(-1)?.kind).toBe('turn-terminal');
+    stream.dispose();
+  });
+
+  it('keeps absent native turn state explicitly incomplete', async () => {
+    const stream = new SessionStreamService({ messages: { listAfter: async () => ({ status: 'ok', messages: [] }) }, turnStatus: () => undefined });
+    const frames = await collect(stream.resume({ sessionId: 'root', turnId: 'missing' }));
+    expect(frames.map((frame) => frame.kind)).toEqual(['resync-required']);
+    stream.dispose();
+  });
+
+  it.each(['failed', 'aborted'])('preserves a durable %s status instead of fabricating successful termination', async (status) => {
+    const stream = new SessionStreamService({ messages: { listAfter: async () => ({ status: 'ok', messages: [] }) }, turnStatus: () => status });
+    const frames = await collect(stream.resume({ sessionId: 'root', turnId: 'failed-root' }));
+    expect(frames).toHaveLength(1);
+    expect(frames[0]?.data).toEqual({ status });
+    stream.dispose();
+  });
+
+  it('keeps ordinary unanchored resume live-only when no turn is selected', async () => {
+    const stream = new SessionStreamService({ messages: { listAfter: async () => ({ status: 'ok', messages: [message('old')] }) }, turnStatus: () => 'completed' });
+    committed(stream, 'old'); terminal(stream, 'old');
+    const source = stream.resume({ sessionId: 'root' });
+    committed(stream, 'new'); terminal(stream, 'new');
+    const frames = await collect(source);
+    expect(frames.every((frame) => frame.turnId === 'new')).toBe(true);
+    expect(frames.at(-1)?.kind).toBe('turn-terminal');
+    stream.dispose();
+  });
+});
