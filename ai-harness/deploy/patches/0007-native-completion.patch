+import { createHash, randomUUID } from 'node:crypto';
+import {
+  closeSync,
+  chmodSync,
+  existsSync,
+  fsyncSync,
+  mkdirSync,
+  openSync,
+  readFileSync,
+  readdirSync,
+  renameSync,
+  writeFileSync,
+} from 'node:fs';
+import { dirname, join } from 'node:path';
+import { and, asc, eq, inArray } from 'drizzle-orm';
+import type { BackgroundTask } from '@mavis/background-task';
+import type { AppDb } from '../../infra/db/client.js';
+import { sessions } from '../../infra/db/schema/sessions.js';
+import { turnIngress } from '../../infra/db/schema/turn.js';
+import { queueItems, queuePauses } from '../../infra/db/schema/queue.js';
+import type { TurnSystemOwner } from '../../service/turn-system/contracts.js';
+
+export interface NativeRunReceipt {
+  readonly schemaVersion: 1;
+  readonly instanceId: string;
+  readonly rootSessionId: string;
+  readonly runId: string | null;
+  readonly exhaustive: boolean;
+  readonly state: 'running' | 'settled' | 'cancelled' | 'unknown';
+  readonly rootTurnIds: readonly string[];
+  readonly reasons: readonly string[];
+}
+
+export interface NativeRunSettlement {
+  begin(sessionId: string, runId: string): Promise<NativeRunReceipt>;
+  get(
+    sessionId: string,
+    expected?: { readonly instanceId?: string; readonly runId?: string },
+  ): Promise<NativeRunReceipt>;
+  wait(
+    sessionId: string,
+    runId: string,
+    afterRootTurnIds: readonly string[],
+    signal: AbortSignal,
+  ): Promise<NativeRunReceipt>;
+  cancel(sessionId: string, runId?: string): Promise<NativeRunReceipt>;
+}
+
+export interface NativeBackgroundSettlement {
+  inspect(
+    ownerSessionIds: readonly string[],
+    taskIds: readonly string[],
+  ): {
+    readonly runners: {
+      readonly active: number;
+      readonly unscoped: number;
+      readonly revision: number;
+      readonly failedOwnerSessionIds?: readonly string[];
+    };
+    readonly delivery: {
+      readonly pendingTaskIds: readonly string[];
+      readonly lookupTaskIds: readonly string[];
+      readonly unscopedLookupTaskIds: readonly string[];
+      readonly inFlightOwnerSessionIds: readonly string[];
+      readonly acknowledgedTaskIds: readonly string[];
+      readonly closed: boolean;
+    };
+  };
+  subscribe(listener: () => void): () => void;
+  latch(ownerSessionIds: readonly string[]): void;
+  drain(ownerSessionIds: readonly string[]): Promise<void>;
+  rearm(ownerSessionIds: readonly string[], taskIds: readonly string[]): void;
+  suppress(tasks: readonly BackgroundTask[]): Promise<void>;
+  acknowledge?(tasks: readonly BackgroundTask[]): Promise<void>;
+  list(ownerSessionId: string): Promise<readonly BackgroundTask[]>;
+}
+
+interface NativeTurnRow {
+  readonly turnId: string;
+  readonly status: string;
+  readonly acceptedSequence: number | null;
+}
+interface Run {
+  readonly rootSessionId: string;
+  readonly runId: string;
+  readonly baselineTurnIds: ReadonlySet<string>;
+  rootTurnIds: string[];
+  canceled: boolean;
+  cancelPrepared: boolean;
+  phase: number;
+  terminalOwnerIds?: readonly string[];
+  terminalTaskIds?: readonly string[];
+  unknown?: string;
+  terminal?: 'settled' | 'cancelled';
+  cancelPromise?: Promise<NativeRunReceipt>;
+}
+
+export interface NativeSettlementEvidence {
+  /** Uncapped, authoritative full subtree including root. Throw on incomplete enumeration. */
+  tree(rootSessionId: string): readonly string[];
+  rootTurns(rootSessionId: string): readonly NativeTurnRow[];
+  pendingQueue(sessionIds: readonly string[]): number;
+  readonly turns: Pick<TurnSystemOwner, 'inspection' | 'sessionLifecycle' | 'turns'>;
+  readonly background: NativeBackgroundSettlement;
+  subscribe(listener: () => void): () => void;
+  pauseQueue?(sessionIds: readonly string[], runId: string): void;
+}
+
+/** This observes native scheduling. It never owns a capacity or retry scheduler. */
+export class NativeRunSettlementService implements NativeRunSettlement {
+  readonly instanceId = randomUUID();
+  private readonly runs = new Map<string, Run>();
+  private readonly listeners = new Set<() => void>();
+  private readonly beginning = new Set<string>();
+  private revision = 0;
+  private readonly guardDir: string;
+
+  constructor(
+    private readonly evidence: NativeSettlementEvidence,
+    dataDir: string,
+  ) {
+    this.guardDir = join(dataDir, 'v2', 'native-run-guards');
+    const changed = () => {
+      this.revision++;
+      for (const listener of this.listeners) listener();
+    };
+    evidence.subscribe(changed);
+    evidence.turns.inspection?.subscribe?.(changed);
+    evidence.background.subscribe(changed);
+  }
+
+  /** Must finish before conversation binding can replay persisted task delivery. */
+  async restoreInterruptedRuns(): Promise<void> {
+    if (!existsSync(this.guardDir)) return;
+    for (const name of readdirSync(this.guardDir).filter((name) => name.endsWith('.json'))) {
+      const record: unknown = JSON.parse(readFileSync(join(this.guardDir, name), 'utf8'));
+      if (!isGuard(record)) throw new Error('Invalid native run cancellation guard');
+      const clean = record.state === 'settled' || record.state === 'cancelled';
+      const run: Run = {
+        rootSessionId: record.rootSessionId,
+        runId: record.runId,
+        baselineTurnIds: new Set(record.baselineTurnIds ?? []),
+        rootTurnIds: [...(record.rootTurnIds ?? [])],
+        canceled: record.state !== 'settled',
+        cancelPrepared: record.state === 'cancelled',
+        phase: 0,
+        terminal: clean ? record.state : undefined,
+        terminalOwnerIds: record.ownerSessionIds,
+        terminalTaskIds: record.taskIds,
+        unknown: clean ? undefined : 'interrupted_native_run',
+      };
+      this.runs.set(run.rootSessionId, run);
+      if (record.state === 'settled') {
+        // A checkpoint identifies the last run; current durable/native evidence still proves it.
+        const receipt = await this.get(run.rootSessionId, { runId: run.runId });
+        if (receipt.state === 'settled') continue;
+        run.unknown ??= 'restored_native_run_unconfirmed';
+        run.terminal = undefined;
+        run.canceled = true;
+        run.cancelPrepared = false;
+        // Invalidate the checkpoint before suppressing anything that could otherwise replay.
+        this.writeGuard(run);
+      }
+      this.evidence.background.latch([run.rootSessionId]);
+      try {
+        const owners = this.evidence.tree(run.rootSessionId);
+        this.evidence.background.latch(owners);
+        this.evidence.pauseQueue?.(owners, run.runId);
+        await this.evidence.background.suppress(await this.tasks(owners));
+      } catch {
+        run.unknown = 'interrupted_native_run_inspection_failed';
+        run.terminal = undefined;
+        this.writeGuard(run);
+      }
+    }
+  }
+
+  async begin(sessionId: string, runId: string): Promise<NativeRunReceipt> {
+    const prior = this.runs.get(sessionId);
+    if (this.beginning.has(sessionId) || (prior && !prior.terminal))
+      return this.receipt(prior ?? sessionId, 'unknown', ['previous_run_unsettled']);
+    if (prior?.runId === runId) return this.receipt(prior, 'unknown', ['reused_run_identity']);
+    this.beginning.add(sessionId);
+    const run: Run = {
+      rootSessionId: sessionId,
+      runId,
+      baselineTurnIds: new Set(),
+      rootTurnIds: [],
+      canceled: false,
+      cancelPrepared: false,
+      phase: 0,
+    };
+    try {
+      // A prior receipt is a proof at a particular point, never permission to skip inspection.
+      if (prior) {
+        const receipt = await this.get(sessionId, { runId: prior.runId });
+        if (receipt.state !== 'settled' && receipt.state !== 'cancelled')
+          return this.receipt(prior, 'unknown', ['previous_run_unsettled', ...receipt.reasons]);
+      }
+      const owners = this.evidence.tree(sessionId);
+      const revision = this.revision;
+      const phase = prior?.phase;
+      const reasons = await this.withIdleFences(owners, async () => {
+        if (!sameSet(owners, this.evidence.tree(sessionId))) return ['native_tree_changed'];
+        if (this.runs.get(sessionId) !== prior || prior?.phase !== phase)
+          return ['native_run_changed'];
+        const rows = this.evidence.rootTurns(sessionId);
+        if (rows.some((row) => row.turnId === runId)) return ['reused_run_identity'];
+        (run as { baselineTurnIds: ReadonlySet<string> }).baselineTurnIds = new Set(
+          rows.map((row) => row.turnId),
+        );
+        const tasks = await this.tasks(owners);
+        if (!prior && (rows.length || tasks.length || owners.length !== 1))
+          return ['untracked_native_history'];
+        const reasons = await this.busyReasons(prior ?? run, owners, tasks, !prior);
+        if (prior?.unknown) return [prior.unknown];
+        if (run.unknown) return [run.unknown];
+        if (revision !== this.revision || prior?.phase !== phase)
+          reasons.push('native_state_changed');
+        if (prior?.canceled && (!prior.cancelPrepared || prior.terminal !== 'cancelled'))
+          reasons.push('native_cancel_pending');
+        if (reasons.length) return reasons;
+        // Replace the clean marker before reopening admission: interruption from here is unknown.
+        this.writeGuard(run);
+        this.runs.set(sessionId, run);
+        if (prior?.canceled)
+          this.evidence.background.rearm(
+            owners,
+            tasks.map((task) => task.taskId),
+          );
+        return [];
+      });
+      if (reasons.length)
+        return this.receipt(prior ?? run, 'unknown', ['preexisting_native_work', ...reasons]);
+      return this.receipt(run, 'running', ['root_admission_pending']);
+    } catch {
+      run.unknown = 'native_inspection_or_rearm_failed';
+      this.runs.set(sessionId, run);
+      try {
+        this.writeGuard(run);
+      } catch {
+        /* Failure remains explicit and cannot admit. */
+      }
+      return this.receipt(run, 'unknown', [run.unknown]);
+    } finally {
+      this.beginning.delete(sessionId);
+    }
+  }
+
+  async get(
+    sessionId: string,
+    expected?: { readonly instanceId?: string; readonly runId?: string },
+  ): Promise<NativeRunReceipt> {
+    const run = this.runs.get(sessionId);
+    if (
+      (expected?.instanceId !== undefined && expected.instanceId !== this.instanceId) ||
+      (expected?.runId !== undefined && expected.runId !== run?.runId)
+    )
+      return this.receipt(run ?? sessionId, 'unknown', ['stale_native_identity']);
+    if (!run) return this.receipt(sessionId, 'unknown', ['no_current_native_run']);
+    if (run.unknown) return this.receipt(run, 'unknown', [run.unknown]);
+    if (run.canceled && !run.cancelPrepared)
+      return this.receipt(run, 'running', ['native_cancel_pending']);
+    const phase = run.phase;
+    const wasTerminal = run.terminal;
+    const priorRootTurns = [...run.rootTurnIds];
+    const terminalChanged = (owners: readonly string[], tasks: readonly BackgroundTask[]) =>
+      wasTerminal &&
+      (!sameSet(priorRootTurns, run.rootTurnIds) ||
+        (run.terminalOwnerIds && !sameSet(run.terminalOwnerIds, owners)) ||
+        (run.terminalTaskIds &&
+          !sameSet(
+            run.terminalTaskIds,
+            tasks.map((task) => task.taskId),
+          )));
+    try {
+      const owners = this.evidence.tree(sessionId);
+      const tasks = await this.tasks(owners);
+      const reasons = await this.busyReasons(run, owners, tasks);
+      if (this.runs.get(sessionId) !== run)
+        return this.receipt(run, 'unknown', ['stale_native_identity']);
+      if (run.unknown) {
+        this.writeGuard(run);
+        return this.receipt(run, 'unknown', [run.unknown]);
+      }
+      if (run.phase !== phase || (run.canceled && !run.cancelPrepared))
+        return this.receipt(run, 'running', ['native_cancel_pending']);
+      if (wasTerminal && (reasons.length || terminalChanged(owners, tasks))) {
+        run.unknown = 'native_work_after_settlement';
+        this.writeGuard(run);
+        return this.receipt(run, 'unknown', [run.unknown]);
+      }
+      if (reasons.length) return this.receipt(run, 'running', reasons);
+      const revision = this.revision;
+      const remaining = await this.withIdleFences(owners, async () => {
+        if (this.runs.get(sessionId) !== run) return ['stale_native_identity'];
+        if (!sameSet(owners, this.evidence.tree(sessionId))) return ['native_tree_changed'];
+        let tasks = await this.tasks(owners);
+        let reasons = await this.busyReasons(run, owners, tasks);
+        if (this.runs.get(sessionId) !== run) return ['stale_native_identity'];
+        if (revision !== this.revision) reasons.push('native_state_changed');
+        if (run.phase !== phase || (run.canceled && !run.cancelPrepared))
+          reasons.push('native_cancel_pending');
+        if (reasons.length || run.unknown) return reasons;
+        // ACK persistence may emit its own native events. Re-inspect after the await, including
+        // the cancellation phase, rather than treating a pre-ACK snapshot as a final proof.
+        if (!run.canceled) await this.evidence.background.acknowledge?.(tasks);
+        const afterAcknowledgment = this.revision;
+        tasks = await this.tasks(owners);
+        reasons = await this.busyReasons(run, owners, tasks);
+        if (!sameSet(owners, this.evidence.tree(sessionId))) reasons.push('native_tree_changed');
+        if (afterAcknowledgment !== this.revision) reasons.push('native_state_changed');
+        if (run.phase !== phase || (run.canceled && !run.cancelPrepared))
+          reasons.push('native_cancel_pending');
+        if (this.runs.get(sessionId) !== run) return ['stale_native_identity'];
+        if (run.phase !== phase || (run.canceled && !run.cancelPrepared)) return reasons;
+        if (wasTerminal && (reasons.length || terminalChanged(owners, tasks)))
+          run.unknown = 'native_work_after_settlement';
+        if (reasons.length || run.unknown) return reasons;
+        run.terminalOwnerIds = [...owners];
+        run.terminalTaskIds = tasks.map((task) => task.taskId);
+        run.terminal = run.canceled ? 'cancelled' : 'settled';
+        this.writeGuard(run);
+        return [];
+      });
+      if (this.runs.get(sessionId) !== run)
+        return this.receipt(run, 'unknown', ['stale_native_identity']);
+      if (run.unknown) {
+        this.writeGuard(run);
+        return this.receipt(run, 'unknown', [run.unknown]);
+      }
+      if (run.phase !== phase || (run.canceled && !run.cancelPrepared))
+        return this.receipt(run, 'running', ['native_cancel_pending']);
+      if (remaining.length) return this.receipt(run, 'running', remaining);
+      return this.receipt(run, run.terminal!, []);
+    } catch {
+      if (this.runs.get(sessionId) !== run)
+        return this.receipt(run, 'unknown', ['stale_native_identity']);
+      run.unknown = 'native_inspection_or_fence_failed';
+      try {
+        this.writeGuard(run);
+      } catch {
+        /* This receipt can never authorize reuse. */
+      }
+      return this.receipt(run, 'unknown', [run.unknown]);
+    }
+  }
+
+  private async withIdleFences(
+    owners: readonly string[],
+    inspect: () => Promise<string[]>,
+  ): Promise<string[]> {
+    const fence = this.evidence.turns.sessionLifecycle.tryRunExclusive;
+    if (!fence || !this.evidence.turns.inspection) return ['native_fence_unavailable'];
+    // Short admission barriers only: never wait for native delivery or runner drain here.
+    const prove = async (index: number): Promise<string[]> => {
+      if (index === owners.length) return inspect();
+      const result = await fence(owners[index]!, async (signal) => {
+        if (signal?.aborted) throw new Error('Native admission fence lost');
+        const result = await prove(index + 1);
+        if (signal?.aborted) throw new Error('Native admission fence lost');
+        return result;
+      });
+      return result.acquired ? result.value : ['native_admission_busy'];
+    };
+    return prove(0);
+  }
+
+  async wait(
+    sessionId: string,
+    runId: string,
+    afterRootTurnIds: readonly string[],
+    signal: AbortSignal,
+  ): Promise<NativeRunReceipt> {
+    const after = new Set(afterRootTurnIds);
+    // Called after the initial execution stream ends; absence here is an admission failure, not idle.
+    const run = this.runs.get(sessionId);
+    if (!run || run.runId !== runId)
+      return this.receipt(run ?? sessionId, 'unknown', ['stale_native_identity']);
+    if (
+      !run.canceled &&
+      !this.evidence.rootTurns(sessionId).some((row) => row.turnId === runId)
+    ) {
+      run.unknown = 'root_not_admitted';
+    }
+    while (true) {
+      let wake!: () => void;
+      const changed = new Promise<void>((resolve) => {
+        wake = resolve;
+      });
+      this.listeners.add(wake);
+      signal.addEventListener('abort', wake, { once: true });
+      const revision = this.revision;
+      try {
+        if (signal.aborted) return await this.cancel(sessionId, runId);
+        const receipt = await this.get(sessionId, { runId });
+        if (receipt.state !== 'running' || receipt.rootTurnIds.some((id) => !after.has(id)))
+          return receipt;
+        if (revision !== this.revision) continue;
+        await changed;
+      } finally {
+        this.listeners.delete(wake);
+        signal.removeEventListener('abort', wake);
+      }
+    }
+  }
+
+  cancel(sessionId: string, runId?: string): Promise<NativeRunReceipt> {
+    const run = this.runs.get(sessionId);
+    if (!run || (runId !== undefined && runId !== run.runId))
+      return Promise.resolve(this.receipt(run ?? sessionId, 'unknown', ['stale_native_identity']));
+    if (run.canceled)
+      return run.cancelPrepared
+        ? this.get(sessionId, { runId: run.runId })
+        : (run.cancelPromise ??
+            Promise.resolve(
+              this.receipt(run, 'unknown', [run.unknown ?? 'native_cancel_pending']),
+            ));
+    // All latches and the durable guard precede the first await and the caller's transport abort.
+    run.canceled = true;
+    run.cancelPrepared = false;
+    run.phase++;
+    run.terminal = undefined;
+    try {
+      this.evidence.background.latch([sessionId]);
+      const owners = this.evidence.tree(sessionId);
+      this.evidence.background.latch(owners);
+      this.writeGuard(run);
+      this.evidence.pauseQueue?.(owners, run.runId);
+    } catch {
+      run.unknown = 'cancel_latch_or_persistence_failed';
+    }
+    run.cancelPromise ??= this.drainCancellation(run);
+    return run.cancelPromise;
+  }
+
+  private async drainCancellation(run: Run): Promise<NativeRunReceipt> {
+    try {
+      let owners = this.evidence.tree(run.rootSessionId);
+      this.evidence.background.latch(owners);
+      await this.evidence.background.suppress(await this.tasks(owners));
+      const outcomes = await Promise.all(
+        owners.map((sessionId) =>
+          this.evidence.turns.turns.abort({
+            sessionId,
+            reason: 'native-run-cancelled',
+          }),
+        ),
+      );
+      if (
+        outcomes.some(
+          (result) => result.status === 'abort-timeout' || result.status === 'turn-mismatch',
+        )
+      )
+        run.unknown = 'native_abort_unconfirmed';
+      // Drain is safe only after native abort released; otherwise expose unknown for container cleanup.
+      if (!run.unknown) {
+        let timer: ReturnType<typeof setTimeout> | undefined;
+        const drained = await Promise.race([
+          this.evidence.background.drain(owners).then(() => true),
+          new Promise<false>((resolve) => {
+            timer = setTimeout(() => resolve(false), 1_000);
+          }),
+        ]).finally(() => {
+          if (timer) clearTimeout(timer);
+        });
+        if (!drained) run.unknown = 'native_cancel_drain_timeout';
+      }
+      // Ingress already beyond its cancellation hook may admit while the first abort releases.
+      const lateOutcomes = await Promise.all(
+        owners.map((sessionId) =>
+          this.evidence.turns.turns.abort({
+            sessionId,
+            reason: 'native-run-cancelled',
+          }),
+        ),
+      );
+      if (
+        lateOutcomes.some(
+          (result) => result.status === 'abort-timeout' || result.status === 'turn-mismatch',
+        )
+      )
+        run.unknown = 'native_abort_unconfirmed';
+      const finalOwners = this.evidence.tree(run.rootSessionId);
+      if (!sameSet(owners, finalOwners)) {
+        owners = finalOwners;
+        this.evidence.background.latch(owners);
+        run.unknown = 'native_tree_changed_during_cancel';
+      }
+      await this.evidence.background.suppress(await this.tasks(owners));
+      run.cancelPrepared = true;
+      const receipt = await this.get(run.rootSessionId, { runId: run.runId });
+      if (receipt.state === 'running') {
+        run.unknown = 'native_cancel_work_remaining';
+        return this.receipt(run, 'unknown', receipt.reasons);
+      }
+      return receipt;
+    } catch {
+      run.unknown = 'native_cancel_failed';
+      return this.receipt(run, 'unknown', [run.unknown]);
+    } finally {
+      this.revision++;
+      for (const listener of this.listeners) listener();
+    }
+  }
+
+  private async tasks(owners: readonly string[]): Promise<BackgroundTask[]> {
+    return (await Promise.all(owners.map((owner) => this.evidence.background.list(owner)))).flat();
+  }
+
+  private async busyReasons(
+    run: Run,
+    owners: readonly string[],
+    tasks: readonly BackgroundTask[],
+    beforeAdmission = false,
+  ): Promise<string[]> {
+    const rows = this.evidence
+      .rootTurns(run.rootSessionId)
+      .filter((row) => !run.baselineTurnIds.has(row.turnId));
+    run.rootTurnIds = rows.map((row) => row.turnId);
+    if (!beforeAdmission && !run.canceled && !rows.some((row) => row.turnId === run.runId))
+      return ['root_admission_pending'];
+    if (!run.canceled && rows.some((row) => row.status === 'failed' || row.status === 'aborted'))
+      run.unknown = 'native_root_failed_or_interrupted';
+    const inspection = this.evidence.turns.inspection;
+    if (!inspection) {
+      run.unknown = 'native_inspection_unavailable';
+      return [];
+    }
+    const reasons: string[] = [];
+    let rootHasOwner = false;
+    for (const owner of owners) {
+      const active = await inspection.activeTurn(owner);
+      const localTurnId = inspection.activeTurnId(owner);
+      if (
+        !active &&
+        !localTurnId &&
+        this.evidence.rootTurns(owner).some((row) => row.status === 'accepted')
+      )
+        run.unknown = 'native_turn_ownership_lost';
+      // Admission commits before local controller registration, and release does the reverse.
+      // A durable foreign/uncertain owner therefore blocks proof without declaring a crash.
+      if (active && !active.locallyOwned) reasons.push('native_ownership_unconfirmed');
+      if (active || localTurnId) {
+        reasons.push('native_turn_active');
+        if (owner === run.rootSessionId) rootHasOwner = true;
+      }
+    }
+    if (rows.some((row) => row.status === 'accepted') && !rootHasOwner)
+      run.unknown = 'native_turn_ownership_lost';
+    if (this.evidence.pendingQueue(owners)) reasons.push('native_queue_pending');
+    const work = this.evidence.background.inspect(
+      owners,
+      tasks.map((task) => task.taskId),
+    );
+    if (work.runners.failedOwnerSessionIds?.length) run.unknown = 'native_runner_failed';
