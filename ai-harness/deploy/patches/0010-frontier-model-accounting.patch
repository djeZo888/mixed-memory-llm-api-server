+++ b/packages/local-runtime-v2/src/service/model-system/resolution/model-token-estimator.ts
@@ -0,0 +1,21 @@
+import { Buffer } from 'node:buffer';
+import type { AgentMessage } from '@earendil-works/pi-agent-core';
+import { BpeTokenEstimator, createDefaultTokenEstimator, type TokenEstimator } from '@mavis/context-manager';
+
+/** Local scheduling heuristic only, NOT the GLM tokenizer or an admission proof.
+ * The host gateway counts the fully rendered prompt with the pinned upstream
+ * tokenizer/template before EVERY frontier inference, including compaction.
+ * UTF-8 sizing deliberately triggers earlier compaction than o200k for Flash.
+ * Qwen and every other provider retain their original estimator instance.
+ */
+class FrontierSchedulingEstimator extends BpeTokenEstimator {
+  override estimateTextTokens(text: string): number { return Buffer.byteLength(text, 'utf8'); }
+  override estimateMessage(message: AgentMessage): number {
+    return Buffer.byteLength(JSON.stringify(message), 'utf8') + 256;
+  }
+}
+const frontierEstimator = new FrontierSchedulingEstimator();
+export function modelTokenEstimator(model: { provider: string; id: string }): TokenEstimator {
+  return model.provider === 'custom_provider:frontier' && model.id === 'glm-5.3-flash'
+    ? frontierEstimator : createDefaultTokenEstimator();
+}
