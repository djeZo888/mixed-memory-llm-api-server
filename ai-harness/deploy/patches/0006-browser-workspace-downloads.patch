+// ai-harness downloads: only the canonical workspace owns browser artifacts.
+export async function ensureWorkspaceBrowserDownloadDirectory(directory: string): Promise<void> {
+  const workspace = process.cwd();
+  if (await realpath(workspace) !== workspace) throw new Error('UNSAFE_BROWSER_WORKSPACE');
+  const parts = relative(workspace, directory).split('/');
+  if (
+    parts.length !== 3 || parts[0] !== 'downloads' || parts[1] !== 'browser' ||
+    !/^[a-zA-Z0-9._-]{1,64}-[a-f0-9]{16}$/u.test(parts[2] ?? '') ||
+    directory !== join(workspace, ...parts)
+  ) throw new Error('UNSAFE_BROWSER_DOWNLOAD_DIRECTORY');
+  let current = workspace;
+  for (const part of parts) {
+    current = join(current, part);
+    await mkdir(current, { mode: 0o700 }).catch((error: NodeJS.ErrnoException) => {
+      if (error.code !== 'EEXIST') throw error;
+    });
+    const info = await lstat(current);
+    if (info.isSymbolicLink() || !info.isDirectory() || await realpath(current) !== current) {
+      throw new Error('UNSAFE_BROWSER_DOWNLOAD_DIRECTORY');
+    }
+  }
+  await chmod(directory, 0o700);
+  // Chrome chooses a GUID destination, but reject any pre-existing unsafe entry
+  // before launch and each action rather than relying on filename sanitization.
+  for (const name of await readdir(directory)) {
+    const info = await lstat(join(directory, name));
+    if (info.isSymbolicLink() || !info.isFile() || info.nlink !== 1) {
+      throw new Error('UNSAFE_BROWSER_DOWNLOAD_DESTINATION');
+    }
+  }
+}
+
+export async function completedWorkspaceBrowserDownloadPath(
+  directory: string,
+  guid: unknown,
+): Promise<string> {
+  if (typeof guid !== 'string' ||
+      !/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/u.test(guid)) {
+    throw new Error('UNSAFE_BROWSER_DOWNLOAD_GUID');
+  }
+  await ensureWorkspaceBrowserDownloadDirectory(directory);
+  const filePath = join(directory, guid);
+  const info = await lstat(filePath);
+  if (info.isSymbolicLink() || !info.isFile() || info.nlink !== 1 ||
+      await realpath(filePath) !== filePath) {
+    throw new Error('UNSAFE_BROWSER_DOWNLOAD_DESTINATION');
+  }
+  return relative(process.cwd(), filePath);
+}
