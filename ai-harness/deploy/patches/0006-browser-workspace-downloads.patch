+// ai-harness download result: never expose guessed or unfinished native paths.
+export async function exposeWorkspaceBrowserDownload(
+  result: unknown,
+  directory: string,
+): Promise<unknown> {
+  if (!isRecord(result) || !isRecord(result.download)) return result;
+  const download = { ...result.download };
+  delete download.filePath;
+  if (download.state === 'completed') {
+    download.filePath = await completedWorkspaceBrowserDownloadPath(directory, download.guid);
+  }
+  return { ...result, download };
+}
