# SOURCE TEMPLATE ONLY. Root-reviewed installed source and paths required.
# Replace @HELPER_FILE@ and @HARNESS_GROUP@ with protected source and the existing
# ordinary harness user's primary group. No new Linux login user or sudoers grant.
[Unit]
Description=ai-harness fixed local administrative owner adapter
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=@HARNESS_GROUP@
ExecStart=/usr/bin/python3 @HELPER_FILE@
RuntimeDirectory=ai-harness-admin
RuntimeDirectoryMode=0750
StateDirectory=ai-harness-admin
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes
# systemd 255's seccomp setup drops CAP_SETUID even for User=root unless ambient.
# Retain it for the fixed runuser UID drop; the ordinary user loses all caps.
AmbientCapabilities=CAP_SETUID
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/ai-harness-admin /var/lib/ai-harness-admin /run/llmctl
ReadOnlyPaths=/var/lib/ai-harness-dispatch
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
