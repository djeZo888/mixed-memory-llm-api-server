diff --git a/tools/server/server-chat-model.h b/tools/server/server-chat-model.h
new file mode 100644
index 000000000..4b14a213d
--- /dev/null
+++ b/tools/server/server-chat-model.h
@@ -0,0 +1,67 @@
+#pragma once
+
+#include "json.h"
+#include "server-http.h"
+
+#include <utility>
+
+// Only standalone chat validates local names. A router forwards its original
+// body to children, whose canonical alias can differ from a router-valid alias.
+inline server_http_context::handler_t server_chat_model_guard(
+        server_http_context::handler_t handler,
+        bool is_router,
+        bool is_child,
+        std::function<common_json()> model_info) {
+    if (is_router || is_child) {
+        return handler;
+    }
+
+    return [handler = std::move(handler), model_info = std::move(model_info)](
+            const server_http_req & req) -> server_http_res_ptr {
+        const auto reject = [](const char * message, const char * param, const char * code) -> server_http_res_ptr {
+            auto res = std::make_unique<server_http_res>();
+            // HTTP status is independent of the OpenAI string/null error code.
+            // Avoid the generator's numeric-code formatter and HTTP's 404 rewrite.
+            res->status = 400;
+            res->data = common_json::object({{"error", common_json::object({
+                {"message", message},
+                {"type", "invalid_request_error"},
+                {"param", param},
+                {"code", code},
+            })}}).dump();
+            return res;
+        };
+
+        const auto body = common_json::parse_no_throw(req.body);
+        if (!body.is_object()) {
+            return reject("Request body must be a JSON object.", nullptr, nullptr);
+        }
+        if (!body.contains("model")) {
+            return handler(req);
+        }
+
+        const auto & model = body.at("model");
+        if (!model.is_string() || model.get<std::string>().empty()) {
+            return reject("Model must be a nonempty string.", "model", nullptr);
+        }
+
+        // Read cached public identity only, after HTTP readiness/auth middleware.
+        // Do not create a response generator: that can wake the model and set up
+        // templates, tasks or resumable stream sessions before validation.
+        const auto info = model_info();
+        if (model == info.at("id")) {
+            return handler(req);
+        }
+        for (const auto & alias : info.at("aliases")) {
+            if (model == alias) {
+                return handler(req);
+            }
+        }
+        return reject("Requested model is not served by this server.", "model", "model_not_found");
+    };
+}
+
+inline void server_chat_register_routes(server_http_context & http, const server_http_context::handler_t & handler) {
+    http.post("/chat/completions", handler);
+    http.post("/v1/chat/completions", handler);
+}
