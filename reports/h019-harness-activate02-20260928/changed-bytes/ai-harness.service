# User unit template. Replace /opt/ai-harness/releases/34959c67baea0d8a357cbea4cefac1658f3553f0-h019-prep01/ai-harness, /home/user/.local/opt/ai-harness/node-v24.21.0, /home/user/.local/share/ai-harness and
# /home/user/.config/ai-harness/browser-approval-key and /home/user/.config/ai-harness/inference-key with reviewed absolute paths; no credentials in this file.
[Unit]
Description=ai-harness v0.0.1 local web server and inference gateway
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
LoadCredential=node-control-key:/home/user/.config/ai-harness/node-control-key
ExecStartPre=/usr/bin/python3 /opt/ai-harness/releases/63dcb23ebd0b2cb82a295bea78192f3e1a433a6e/h005-preparation/state-precheck.py --dispatch
WorkingDirectory=/opt/ai-harness/releases/34959c67baea0d8a357cbea4cefac1658f3553f0-h019-prep01/ai-harness/server
Environment="PATH=/home/user/.local/opt/ai-harness/node-v24.21.0/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/ai-harness/releases/34959c67baea0d8a357cbea4cefac1658f3553f0-h019-prep01/ai-harness/deploy/run-server.sh --node-prefix /home/user/.local/opt/ai-harness/node-v24.21.0 --app-dir /opt/ai-harness/releases/34959c67baea0d8a357cbea4cefac1658f3553f0-h019-prep01/ai-harness --data-dir /home/user/.local/share/ai-harness --inference-key-file /home/user/.config/ai-harness/inference-key --browser-approval-key-file /home/user/.config/ai-harness/browser-approval-key --node-control-key-file %d/node-control-key --frontier-key-file /home/user/.config/ai-harness/inference-key
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=control-group
Delegate=yes
# No NoNewPrivileges/RestrictNamespaces here: rootless Podman needs newuidmap,
# newgidmap and nested user namespaces. Container isolation is in run-engine.sh.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
