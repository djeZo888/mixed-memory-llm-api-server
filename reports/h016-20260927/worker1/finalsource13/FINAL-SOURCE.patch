+        source = Path(c.__file__).read_text()
+        self.assertNotIn("['systemctl', 'start'", source)
+        self.assertNotIn("['systemctl', 'restart'", source)
+        unit = Path(c.__file__).with_name('h016-final13-long.service').read_text()
